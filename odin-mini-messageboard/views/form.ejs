<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>

    <h1>Hello Friend!!</h1>
    <p>welcome to the form</p>
    
    <!-- let form make a network request -->
    <form method="POST" action="/new">
        <label for="authName">Name:</label>
        <input type="text" name="authName" id="authName" placeholder="enter your name..">
        <label for="authMessage">Message:</label>
        <input type="text" name="authMessage" id="authMessage" placeholder="enter your message...">
        <button type="submit">Submit</button>
    </form>
    <a href="/">Back</a>    
</body>
</html>